import std
import std::Option

struct Point(x: f32, y: f32)
extend Point {
  fn distance_squared(self) -> f64 {
    self.x * self.x + self.y * self.y
  }
}

enum Void{}
enum Option<T> {
  some(T),
  none,
}

fn add(a: usize, b: usize) -> usize {
  a + b
}

fn sub(_ a: usize, _ b: usize) -> usize {
  a - b
}

fn mul(x a: usize, y b: usize) -> usize {
  a - b
}

